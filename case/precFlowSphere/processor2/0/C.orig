FoamFile
{
    version     2.0;
    format      binary;
    class       volScalarField;
    arch        "LSB;label=32;scalar=64";
    location    "0";
    object      C.orig;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 -3 0 0 1 0 0];


internalField   uniform 5;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           nonuniform 0;
    }
    outlet
    {
        type            zeroGradient;
    }
    sphere
    {
        type            zeroGradient;
    }
    wall
    {
        type            zeroGradient;
    }
    procBoundary2to1
    {
        type            processor;
        value           uniform 5;
    }
    procBoundary2to3
    {
        type            processor;
        value           uniform 5;
    }
}


// ************************************************************************* //
