FoamFile
{
    version     2.0;
    format      binary;
    class       volScalarField;
    arch        "LSB;label=32;scalar=64";
    location    "70";
    object      rAU;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [-1 3 1 0 0 0 0];


internalField   uniform 1;

boundaryField
{
    inlet
    {
        type            calculated;
        value           nonuniform 0;
    }
    outlet
    {
        type            calculated;
        value           uniform 1;
    }
    sphere
    {
        type            calculated;
        value           nonuniform 0;
    }
    wall
    {
        type            calculated;
        value           uniform 1;
    }
    procBoundary3to2
    {
        type            processor;
        value           uniform 1;
    }
}


