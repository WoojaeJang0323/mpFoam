FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties.liquid;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState Boussinesq;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        nMoles          1;
        molWeight       18.01528;
    }

    equationOfState
    {
        beta            2.57e-4;
        rho0            1000;
        T0              298.15;
    }

    thermodynamics
    {
        Cp              4180;
        Hf              0;
    }

    transport
    {
        mu              8.9e-4;
        Pr              7.0;
    }
}

