FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties.solid;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heSolidThermo;
    mixture         pureMixture;
    transport       constIso;
    thermo          hConst;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        nMoles          1;
        molWeight       233.39;
    }

    equationOfState
    {
        rho             4480;
    }

    thermodynamics
    {
        Cp              435;
        Hf              0;
    }

    transport
    {
        kappa           1.0;
    }
}

// ************************************************************************* //
