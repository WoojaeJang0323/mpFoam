// Domain matches bounding box of pillars_scaled2.stl
// X: 0 .. 1.82e-3 m, Y: 0 .. 9.513844e-4 m, Z: 0 .. 2.3e-5 m
// Inlet face (x = 0) is split into 3 inlets along Y, separated by walls.

scale   1;

// X-stations
x0   0;
x1   1.82e-3;

// Z-stations
z0   0;
z1   2.3e-5;

// Y-stations defining 5 stacked Y-blocks
// inlet1: y0..y1, gap1: y1..y2, inlet2: y2..y3, gap2: y3..y4, inlet3: y4..y5
y0   0;
y1   2.630242e-4;
y2   3.427301e-4;
y3   6.086543e-4;
y4   6.883602e-4;
y5   9.513844e-4;

vertices
(
    // y = y0 (i = 0)
    ($x0 $y0 $z0)   // 0
    ($x1 $y0 $z0)   // 1
    ($x1 $y0 $z1)   // 2
    ($x0 $y0 $z1)   // 3

    // y = y1 (i = 1)
    ($x0 $y1 $z0)   // 4
    ($x1 $y1 $z0)   // 5
    ($x1 $y1 $z1)   // 6
