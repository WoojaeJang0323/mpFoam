FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      Ccation;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 -3 0 0 1 0 0];


internalField   uniform 0;

boundaryField
{
    inlet1
    {
        type            fixedValue;
        value           uniform 1.5;
    }
    inlet2
    {
        type            fixedValue;
        value           uniform 0;
    }
    inlet3
    {
        type            fixedValue;
        value           uniform 1.5;
    }
    inletWalls
    {
        type            zeroGradient;
    }
    outlet
    {
        type            zeroGradient;
    }
    yMin
    {
        type            zeroGradient;
    }
    yMax
    {
        type            zeroGradient;
    }
    zMin
    {
        type            zeroGradient;
    }
    zMax
    {
        type            zeroGradient;
    }
}


