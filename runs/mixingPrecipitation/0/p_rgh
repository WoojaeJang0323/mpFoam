FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet1
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }
    inlet2
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }
    inlet3
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }
    outlet
    {
        type            fixedValue;
        value           uniform 0;
    }
    inletWalls
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }
    yMin
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }
    yMax
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }
    zMin
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }
    zMax
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }
}

