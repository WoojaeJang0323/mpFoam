FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      areaDensityGrad;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 -1 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inletAnion
    {
        type            zeroGradient;
        value           $internalField;
    }

    inletCation
    {
        type            zeroGradient;
        value           $internalField;
    }

    outlet
    {
        type            zeroGradient;
        value           $internalField;
    }

    walls
    {
        type            zeroGradient;
        value           $internalField;
    }

    frontAndBack
    {
        type            empty;
    }
}

